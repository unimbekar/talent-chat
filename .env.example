# Copy to .env. Leave secrets blank in git.
# Argon2 hashes contain $. In this file for Docker Compose, write each $ as $$.
# Or point ADMIN_PASSWORD_HASH_FILE at a file that holds the raw hash.

WEB_PORT=3000
POSTGRES_PASSWORD=postgres
APP_ADMIN_DB_PASSWORD=admin
APP_PUBLIC_DB_PASSWORD=public

DATABASE_URL=postgresql+psycopg://app_admin:admin@127.0.0.1:5432/talent
DATABASE_PUBLIC_URL=postgresql+psycopg://app_public:public@127.0.0.1:5432/talent
DATABASE_MIGRATE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/talent

ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_HASH_FILE=
SESSION_SECRET=

COMPANY_NAME=Janus Soft Inc.
CAREERS_URL=https://www.janus-soft.com/career
CRAWL_INTERVAL_HOURS=6
CRAWL_ON_START=true
PUBLIC_FRAME_ANCESTOR=
TRUSTED_PROXY_HEADER=

# Branding (PRODUCT.md). Pages pick up changes within 5 minutes of `docker compose up -d`.
BRAND_TAGLINE=Find the role that fits you
BRAND_ACCENT="#857251"
BRAND_LOGO_URL=/brand/logo.svg
BRAND_HERO_URL=/brand/hero.webp
BRAND_FOOTER=This tool is not authorized for classified processing and is not a FedRAMP system; do not upload classified documents or CUI.
# Example questions under the chat box, separated by |
CHAT_EXAMPLES=Java, Python, and AWS jobs|Jobs in Chantilly|Do any roles need a clearance?
# Addresses at this domain are staff, not the candidate.
COMPANY_EMAIL_DOMAIN=janus-soft.com
# Host folder shown on the Ingest page and mounted read-only at /library.
RESUME_LIBRARY_HOST=/mnt/synology/janus-soft
# Read every résumé once at start so the first job page opens fast.
WARM_RESUME_CACHE=true

# Cloudflare Tunnel (publish_cloudflare.md). Used only with docker-compose.cloudflare.yml.
CLOUDFLARE_TUNNEL_TOKEN=

# Production only (deploy.md). Leave blank on the Spark.
S3_BUCKET=
BEDROCK_MODEL=amazon.nova-lite-v1:0
PUBLIC_HOST=
ACME_EMAIL=

LLM_BACKEND=openai_compat
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen3.6:latest
LLM_API_KEY=
AWS_REGION=us-east-1

EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
FILE_DIR=./data/uploads
# Host folder mounted into the API container for bulk résumé import. Spark only.
RESUME_HOST_DIR=/mnt/synology/janus-soft/Candidates

DRIVE_FOLDER_ID=
JOB_DESCRIPTION_FOLDER_ID=
SES_FROM_ADDRESS=
OUTREACH_INTERVAL_DAYS=7
OUTREACH_MIN_SCORE=0.62
