flowchart TB
    careers["janus-soft.com<br/>Google Sites, unchanged"]
    dns["DNS name<br/>chat.janus-soft.com"]

    subgraph account["AWS account, us-east-1"]
        direction TB
        r53["Route 53 A record<br/>only if HostedZoneId is set"]
        eip["Elastic IP"]

        subgraph vpc["VPC 10.20.0.0/16"]
            direction TB
            igw["Internet gateway"]
            route["Route table<br/>0.0.0.0/0 to the gateway"]
            subnet["Public subnet<br/>10.20.1.0/24"]
            sg["Security group<br/>80 and 443 open<br/>22 only if SshCidr is set"]
            ec2["EC2 t4g.medium<br/>IMDSv2, hop limit 2<br/>30 GB gp3 encrypted"]
        end

        profile["Instance profile"]
        role["IAM role<br/>stack-instance"]
        s3["S3 bucket<br/>inbox, originals, dumps<br/>dumps expire in 14 days"]
        policy["Bucket policy<br/>deny non-TLS"]
        secret["Secrets Manager<br/>passwords"]
        google["Secrets Manager<br/>Google OAuth client"]
        ssm["Session Manager"]
        bedrock["Bedrock Nova Lite<br/>amazon.nova-lite-v1:0"]
    end

    careers -->|"button to /chat"| dns
    dns -->|"A record"| eip
    r53 -.->|"optional"| eip
    eip --> ec2
    igw --> route --> subnet --> sg --> ec2
    ec2 --> profile --> role
    role --> s3
    role --> secret
    role --> google
    role --> bedrock
    s3 --- policy
    ssm -->|"shell, port 22 closed"| ec2
