flowchart TD
    careers["janus-soft.com/career<br/>listing + /jobs/NNNN pages"]
    a1["Agent 1<br/>Job Discovery"]
    a2["Agent 2<br/>Candidate Matching"]
    a3["Agent 3<br/>Email Drafting"]
    human{{"Recruiter<br/>/admin/outreach"}}
    send["Sender<br/>Amazon SES, or local outbox"]
    inbox(["Candidate inbox"])
    a4["Agent 4<br/>Orchestration + QA + Reliability"]

    careers -->|crawl every 6 h or Recrawl| a1
    a1 -->|JobCreated / JobUpdated| a2
    ingest["Résumé confirmed<br/>on Ingest or Candidates"] -->|CandidateConfirmed| a2
    a2 -->|MatchFound, coverage ≥ 80%| a3
    a3 -->|DraftReady| human
    human -->|DraftApproved| send
    human -->|DraftRejected| a4
    send -->|EmailSent| inbox
    send -->|EmailSent / EmailFailed| a4

    a4 -. routes events, retries, QA gates .-> a1
    a4 -.-> a2
    a4 -.-> a3
    a4 -.-> send
