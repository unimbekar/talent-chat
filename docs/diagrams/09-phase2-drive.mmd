flowchart TB
    subgraph gd[Google Drive]
        rf[("Résumé folder<br/>DRIVE_FOLDER_ID")]
        jf[("Job description folder<br/>JOB_DESCRIPTION_FOLDER_ID<br/>A1001.pdf, N3011.docx ...")]
    end

    subgraph worker["worker container - python -m app.worker"]
        poll["changes.list every 10 min<br/>stored page token"]
        bf["backfill command<br/>safe to re-run"]
