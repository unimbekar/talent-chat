    db[("Postgres")]
    ui["/admin Ingest + Candidates screens"]

    rf --> poll
    jf --> poll
    bf --> route
    poll --> route
    route -->|"résumé"| exp --> pipe
    route -->|"job description"| jpipe
    pipe -->|"key: google_file_id + sha256<br/>new revision updates same row<br/>status pending_review<br/>outreach_opt_in = false"| db
    jpipe --> db
    pipe -->|"rejects: type, no text, password"| db
    db --> ui
    ui -->|"admin confirms"| db
